{
  "name": "terminal-dm",
  "version": "0.7.1",
  "description": "DM without looking like you're DMing — a discreet Agent CLI-style TUI messenger.",
  "license": "Apache-2.0",
  "author": "mscho <choms0521@gmail.com>",
  "homepage": "https://github.com/choms0521/terminal-dm#readme",
  "bugs": {
    "url": "https://github.com/choms0521/terminal-dm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choms0521/terminal-dm.git"
  },
  "keywords": [
    "cli",
    "tui",
    "instagram",
    "kakaotalk",
    "messaging",
    "terminal"
  ],
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "bin": {
    "dm": "dist/cli.js",
    "terminal-dm": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "node --import tsx src/cli.tsx",
    "postinstall": "node scripts/patch-ink-static-fullscreen.mjs && playwright-core install chromium --no-shell",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
